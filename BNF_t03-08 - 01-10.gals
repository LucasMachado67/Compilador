#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
Parser = LL
#RegularDefinitions
// definições regulares
// auxiliares


min: [a-z]
mai: [A-Z]
dig: [0-9]

letra: {mai} | {min}

bloco: # [^#]* #
#Tokens
pr:! {min} | {min} ({mai}? {min})*

//comentários
:! {bloco}

// ignora caracteres de formatação
:[\s\t\n]

// Simbolos Especiais
","
"["
"]"
"("
")"
"{"
"}"
"+"
"-"
"*"
"/"
"<-"
"="
"<>"
"<"
">"

// Palavras Reservadas

and = pr : "and" 
false = pr : "false"
if = pr : "if"
in = pr : "in"
isFalseDo = pr : "isFalseDo"
isTrueDo = pr : "isTrueDo"
module = pr : "module"
not = pr : "not"
or = pr : "or"
out = pr : "out"
true = pr : "true"
while = pr : "while"

// nome de variável
int:! i_{letra} ({letra} | {dig})*
float:! f_{letra} ({letra} | {dig})*
string:! s_{letra} ({letra} | {dig})*
bool :! b_{letra} ({letra} | {dig})*

constante_int :! {dig}+
constante_float :! {dig}+,{dig}+
constante_string :! \"[^\n\""\"]*\"

// comentarios
:! {bloco}
#NonTerminals
<programa>
<declaracao_variaveis>
<lista_comandos>
<resto_comandos>
<lista_variaveis>
<resto_variaveis>
<comando>
<id_opcional>
<identificador>
<identificador_uso>
<atribuicao>
<resto_atribuicao>
<entrada>
<saida>
<selecao>
<ramo_selecao>
<repeticao>
<tipo_repeticao>
<expressao>
<lista_identificadores>
<resto_identificadores>
<id_exp>
<resto_id_exp>
<lista_expressoes>
<resto_expressoes>
<opcional_false>
<opcional_true>
<termo_logico>
<expressao_>
<relacional>
<relacional_>
<operador_relacional>
<aritmetica>
<termo_aritmetico>
<termo_aritmetico_>
<aritmetica_>
<fator>
<identificador_expressao>
<vetor>
#Grammar
<programa> ::= module #101 <declaracao_variaveis> "{" <lista_comandos> "}" #102;

<declaracao_variaveis> ::= <lista_variaveis> | î;
<lista_variaveis> ::= <identificador> #103 <resto_variaveis>;
<resto_variaveis> ::= "," <identificador> #103 <resto_variaveis> | î;


<identificador> ::= int <id_opcional> | float <id_opcional> | string <id_opcional> | bool <id_opcional>;
<id_opcional> ::= #104 î | "[" constante_int #105 "]";


<comando> ::= <atribuicao> | <entrada> | <saida> | <selecao> | <repeticao>;
<lista_comandos> ::= <comando> <resto_comandos>;
<resto_comandos> ::= <comando> <resto_comandos> | î;

<identificador_uso>::= int | float | string | bool ;
<atribuicao> ::= <identificador_uso> #103 <resto_atribuicao>;
<resto_atribuicao> ::= "<-" <expressao>  #106 | #107 "[" <expressao> "]" #134 #103 "<-" <expressao> #106;

<entrada> ::= in "(" <lista_identificadores> ")"; 
<lista_identificadores> ::= <id_exp> <resto_identificadores>;
<resto_identificadores> ::= "," <id_exp> <resto_identificadores> | î;

<id_exp> ::= <identificador_uso> #103 <resto_id_exp>;
<resto_id_exp> ::= #107 "[" <expressao> "]" #134 #108 | î;


<saida> ::= out "(" <lista_expressoes> ")";
<lista_expressoes> ::= <expressao> #109 <resto_expressoes>;
<resto_expressoes> ::= "," <lista_expressoes> | î;

<selecao> ::= if "(" <expressao> ")" <ramo_selecao>;
<ramo_selecao> ::= isTrueDo #110 "{" <lista_comandos> "}" <opcional_false>  #111 | isFalseDo #110 "{" <lista_comandos> "}" <opcional_true>  #111;
<opcional_false> ::=  isFalseDo #112  "{" <lista_comandos> "}" | î;
<opcional_true> ::= isTrueDo #112 "{" <lista_comandos> "}" | î;
 
<repeticao> ::= #113 while "(" <expressao> ")" <tipo_repeticao>;
<tipo_repeticao> ::= isTrueDo #114 "{" <lista_comandos> "}" | isFalseDo #114 "{" <lista_comandos> "}" #115;


<expressao> ::= <termo_logico> <expressao_> ;
<expressao_> ::= î | and <termo_logico> #116 <expressao_> | or <termo_logico>  #117 <expressao_> ;
<termo_logico> ::= <relacional> | true #118 | false  #119 | not <termo_logico>  #120 ;
<relacional> ::= <aritmetica> <relacional_> ;
<relacional_> ::= î | <operador_relacional>  #121 <aritmetica>  #122 ;
<operador_relacional>::= "=" | "<>" | "<" | ">" ;
<aritmetica> ::= <termo_aritmetico> <aritmetica_> ;
<aritmetica_> ::= î | "+" <termo_aritmetico> #123 <aritmetica_> |
 "-" <termo_aritmetico>  #124 <aritmetica_> ;
<termo_aritmetico> ::= <fator> <termo_aritmetico_> ;
<termo_aritmetico_> ::= î | "*" <fator> #125 <termo_aritmetico_> | "/" <fator> #126 <termo_aritmetico_> ;
<fator> ::= <identificador_expressao> #127 <vetor> |
 constante_int #128|
 constante_float #129|
 constante_string #130|
 "(" <expressao> ")" |
 "+" <fator> #131|
 "-" <fator> #132;
<identificador_expressao>::= int | float | string | bool;
<vetor> ::= î | "[" <expressao> "]" #133; 

